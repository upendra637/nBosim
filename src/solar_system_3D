# ============================================================
# 6. GET HORIZONS VECTOR
# ============================================================

def get_horizons_state(body_name):

    """
    Obtain heliocentric/barycentric Cartesian state
    from NASA/JPL Horizons.

    Returned units:
        position → AU
        velocity → AU/day
    """

    obj = Horizons(
        id=HORIZONS_IDS[body_name],
        location="@sun",
        epochs=EPOCH_JD
    )

    vectors = obj.vectors()

    x = float(vectors["x"][0])
    y = float(vectors["y"][0])
    z = float(vectors["z"][0])

    vx = float(vectors["vx"][0])
    vy = float(vectors["vy"][0])
    vz = float(vectors["vz"][0])

    return np.array([x, y, z]), np.array([vx, vy, vz])


# ============================================================
# 7. CREATE REBOUND SIMULATION
# ============================================================

def create_simulation():

    sim = rebound.Simulation()

    # REBOUND astronomical units:
    #
    # distance = AU
    # mass     = Solar mass
    # time     = year / 2π
    #
    # Therefore G = 1
    sim.G = 1.0

    # High-accuracy general integrator
    sim.integrator = "ias15"

    print("\nDownloading initial states from NASA/JPL Horizons...\n")

    all_bodies = PLANETS + JUPITER_MOONS

    for body in all_bodies:

        print("Loading:", body)

        position, velocity = get_horizons_state(body)

        # Horizons velocity is AU/day.
        #
        # REBOUND time unit is year/(2π).
        #
        # Convert AU/day → AU / (year/2π)
        #
        # 1 year ≈ 365.25 days

        velocity = velocity * 365.25 / (2.0 * np.pi)

        mass = BODY_MASSES[body]

        sim.add(
            m=mass,
            x=position[0],
            y=position[1],
            z=position[2],
            vx=velocity[0],
            vy=velocity[1],
            vz=velocity[2]
        )

    # Move the entire system to its center of mass.
    sim.move_to_com()

    return sim


# ============================================================
# 8. CREATE SIMULATION
# ============================================================

sim = create_simulation()

print("\nTotal particles:", sim.N)


# ============================================================
# 9. STORE INITIAL POSITIONS
# ============================================================

body_names = PLANETS + JUPITER_MOONS

positions = {
    body: np.zeros((N_FRAMES, 3))
    for body in body_names
}


# ============================================================
# 10. REBOUND TIME
#
# REBOUND time unit:
#
#     T = year / (2π)
#
# Therefore:
#
#     1 year = 2π REBOUND time units
# ============================================================

times = np.linspace(
    0,
    SIMULATION_YEARS * 2.0 * np.pi,
    N_FRAMES
)


# ============================================================
# 11. INTEGRATE THE SYSTEM
# ============================================================

print("\nStarting REBOUND integration...\n")

for frame, t in enumerate(times):

    sim.integrate(t)

    for i, body in enumerate(body_names):

        particle = sim.particles[i]

        positions[body][frame] = [
            particle.x,
            particle.y,
            particle.z
        ]

print("Integration completed.")


# ============================================================
# 12. VISUAL SCALE
#
# The actual Solar System is enormous compared with
# Jupiter's moon system.
#
# Therefore the visualization uses different scales.
#
# IMPORTANT:
# This changes ONLY the display.
# It does NOT change the physics.
# ============================================================

def solar_visual_position(position):

    x, y, z = position

    r = np.sqrt(x*x + y*y + z*z)

    if r == 0:
        return np.array([0.0, 0.0, 0.0])

    # Square-root compression
    scale = np.sqrt(r) / r

    return np.array([
        x * scale,
        y * scale,
        z * scale
    ])


# Apply visual transformation

visual_positions = {
    body: np.zeros_like(positions[body])
    for body in body_names
}


for body in body_names:

    for i in range(N_FRAMES):

        visual_positions[body][i] = \
            solar_visual_position(positions[body][i])


